---
import { bosses } from '@/data/bosses';
import { localizePath, type Lang } from '@/lib/i18n';
interface Props { lang: Lang; limit?: number; }
const { lang, limit } = Astro.props;
const list = typeof limit === 'number' ? bosses.slice(0, limit) : bosses;
const isZh = lang === 'zh-cn';
const chapterMarks = isZh ? ['','壹','贰','叁','肆','伍','陆'] : ['','I','II','III','IV','V','VI'];
---

<div class="card-grid">
  {list.map((boss) => (
    <a class="boss-card" data-chapter-mark={chapterMarks[boss.chapter]} href={localizePath(`/wukong/bosses/${boss.slug}/`, lang)}>
      <div class="card-top">
        <div class="card-meta-row">
          <span class="card-chapter">{isZh ? `第 ${boss.chapter} 回` : `Chapter ${boss.chapter}`}</span>
          {boss.video && <span class="video-badge"><span aria-hidden="true">▶</span> {isZh ? '含视频演示' : 'Video guide'}</span>}
        </div>
        <h2>{boss.name[lang]}</h2>
        <p>{boss.epithet[lang]}</p>
      </div>
      <div class="card-bottom">
        <div>
          <span class="sr-only">{isZh ? '难度' : 'Difficulty'} {boss.difficulty}/5</span>
          <div class="difficulty" aria-hidden="true">{[1,2,3,4,5].map((level) => <i class:list={{ active: level <= boss.difficulty }}></i>)}</div>
        </div>
        <span class="arrow-link">{isZh ? '查看解法' : 'Open solver'} →</span>
      </div>
    </a>
  ))}
</div>
