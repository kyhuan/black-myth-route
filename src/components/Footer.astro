---
import { localizePath, t, type Lang } from '@/lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
const route = (path: string) => localizePath(path, lang);
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <strong>Black Myth Route</strong>
        <span class="muted">{copy.footerLine}</span>
        <p>{copy.unofficial} {copy.rights}</p>
      </div>
      <nav class="footer-links" aria-label={lang === 'zh-cn' ? '页脚导航' : 'Footer navigation'}>
        <a href={route('/wukong/checklist/')}>{copy.navTracker}</a>
        <a href={route('/wukong/bosses/')}>{copy.navBosses}</a>
        <a href={route('/privacy/')}>{copy.privacy}</a>
        <a href={route('/disclaimer/')}>{copy.disclaimer}</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Black Myth Route</span>
      <span>{lang === 'zh-cn' ? '进度数据只保存在你的浏览器中。' : 'Progress data stays in your browser.'}</span>
    </div>
  </div>
</footer>

