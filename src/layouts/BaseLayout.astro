---
import '@/styles/global.css';
import '@/styles/visual-v2.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { alternatePaths, getLangFromUrl, siteName, siteUrl } from '@/lib/i18n';

interface Props {
  title?: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = '/og-default.png',
  noindex = false,
  type = 'website'
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} — Wukong 100% Tracker & Boss Solver`;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, siteUrl);
const paths = alternatePaths(canonicalPath);
const socialImage = new URL(image, siteUrl);
const plausibleDomain = 'blackmythroute.cc';
---

<!doctype html>
<html lang={lang === 'zh-cn' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080807" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en, siteUrl)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(paths.zh, siteUrl)} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.en, siteUrl)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={lang === 'zh-cn' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      try {
        const preferred = localStorage.getItem('bmr:locale');
        const path = location.pathname;
        const isRootVisit = path === '/' || path === '/index.html';
        if (isRootVisit && preferred === 'zh-cn') location.replace('/zh-cn/' + location.search + location.hash);
      } catch {}
    </script>
    {import.meta.env.PROD && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh-cn' ? '跳到正文' : 'Skip to content'}</a>
    <Header lang={lang} pathname={Astro.url.pathname} />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
